<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>disable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>C64Emulator</RootNamespace>
    <AssemblyName>C64Emulator</AssemblyName>
    <ApplicationIcon>c64icon.ico</ApplicationIcon>
    <Version>2.0.0</Version>
    <AssemblyTitle>C64 Emulator</AssemblyTitle>
    <Description>Pipkinsoft C64 Emulator</Description>
    <Company>Pipkinsoft</Company>
    <Product>C64 Emulator</Product>
    <Copyright>Copyright © 2026</Copyright>
  </PropertyGroup>

  <!-- The emulation and rendering loops are too hot to run unoptimized.
       A Debug build without optimization falls to roughly 40% speed when
       the SDL host is active, which is immediately visible in the cursor
       blink rate. Keep Debug symbols, but optimize the generated code. -->
  <PropertyGroup Condition="'$(Configuration)' == 'Debug'">
    <Optimize>true</Optimize>
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="C64Emulator.Tests" />
  </ItemGroup>

  <ItemGroup>
    <!-- The ROMs stay in Roms\ so Solution Explorer groups them there. The
         host loads them from its own directory (AppContext.BaseDirectory), so
         TargetPath flattens the copy to the output root. Link would flatten
         the copy too, but it also moves the files to the project root in
         Solution Explorer. -->
    <None Update="Roms\*.rom">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>%(Filename)%(Extension)</TargetPath>
    </None>
    <None Update="Assets\c64icon.bmp">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
      <TargetPath>c64icon.bmp</TargetPath>
    </None>
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Update="Properties\Resources.resx">
      <Generator>ResXFileCodeGenerator</Generator>
      <LastGenOutput>Resources.Designer.cs</LastGenOutput>
    </EmbeddedResource>
    <Compile Update="Properties\Resources.Designer.cs">
      <AutoGen>true</AutoGen>
      <DesignTime>true</DesignTime>
      <DependentUpon>Resources.resx</DependentUpon>
    </Compile>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="SDL3-CS" Version="3.4.18.1" />
    <PackageReference Include="SDL3-CS.Windows" Version="3.4.18.1" />
    <PackageReference Include="SDL3-CS.Windows.TTF" Version="3.2.2.14" />
  </ItemGroup>

</Project>
